{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Binaries/**)",
      "Read(./Intermediate/**)",
      "Read(./DerivedDataCache/**)",
      "Edit(./**/*.meta)",
      "Edit(./**/*.uasset)",
      "Edit(./**/*.umap)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\detect-engine.ps1\""
          }
        ]
      }
    ]
  }
}
